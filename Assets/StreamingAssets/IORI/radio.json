{
  "version": 1,
  "crossfadeSeconds": 8,
  "defaultWeather": "clear",
  "phases": [
    {
      "id": "early_morning",
      "start": "04:00"
    },
    {
      "id": "morning",
      "start": "07:00"
    },
    {
      "id": "day",
      "start": "11:00"
    },
    {
      "id": "evening",
      "start": "16:00"
    },
    {
      "id": "night",
      "start": "19:00"
    },
    {
      "id": "late_night",
      "start": "23:00"
    }
  ],
  "tracks": [
    {
      "phase": "early_morning",
      "weather": "clear",
      "file": "radio/early_morning_clear.ogg",
      "loop": "seamless"
    },
    {
      "phase": "morning",
      "weather": "clear",
      "file": "radio/morning_clear.ogg",
      "loop": "seamless"
    },
    {
      "phase": "day",
      "weather": "clear",
      "file": "radio/day_clear.ogg",
      "loop": "seamless"
    },
    {
      "phase": "evening",
      "weather": "clear",
      "file": "radio/evening_clear.ogg",
      "loop": "seamless"
    },
    {
      "phase": "night",
      "weather": "clear",
      "file": "radio/night_clear.ogg",
      "loop": "seamless"
    },
    {
      "phase": "late_night",
      "weather": "clear",
      "file": "radio/late_night_clear.ogg",
      "loop": "seamless"
    }
  ],
  "chime": {
    "file": "fx/chime.ogg",
    "volume": 0.5
  },
  "jiho": {
    "file": "voice/jiho_{hh}.ogg",
    "delaySeconds": 1.6,
    "volume": 1
  },
  "quiet": {
    "minGapSeconds": 45,
    "maxGapSeconds": 180,
    "phrases": [
      {
        "file": "placeholder/piano_01.wav",
        "volume": 0.8
      },
      {
        "file": "placeholder/piano_02.wav",
        "volume": 0.8
      },
      {
        "file": "placeholder/piano_03.wav",
        "volume": 0.8
      }
    ]
  },
  "ambient": [
    {
      "id": "fire",
      "file": "ambient/fire.ogg",
      "defaultVolume": 0.7
    },
    {
      "id": "wind",
      "file": "ambient/wind.ogg",
      "defaultVolume": 0.3
    },
    {
      "id": "insects",
      "file": "ambient/insects.ogg",
      "defaultVolume": 0.25
    },
    {
      "id": "rain",
      "file": "ambient/rain.ogg",
      "defaultVolume": 0.7,
      "weathers": [
        "rain"
      ]
    }
  ]
}
